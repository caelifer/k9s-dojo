{
  "uid": "dojo-pipeline-components",
  "title": "Dojo / Pipeline components",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "dojo",
    "otel",
    "pipeline"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Collector",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(otelcol_exporter_sent_spans_total, pod)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Accepted spans/s",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total{pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sent spans/s",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_exporter_sent_spans_total{pod=~\"$pod\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Exporter queue",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(otelcol_exporter_queue_size{pod=~\"$pod\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dropped spans/min",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(otelcol_exporter_send_failed_spans_total{pod=~\"$pod\"}[1m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingest vs export per signal",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (signal) (rate(otelcol_receiver_accepted_spans_total{pod=~\"$pod\"}[5m]))",
          "legendFormat": "in {{signal}}"
        },
        {
          "refId": "B",
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_spans_total{pod=~\"$pod\"}[5m]))",
          "legendFormat": "out {{exporter}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Per-replica throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(otelcol_exporter_sent_spans_total{pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backend health (up)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"kube-state-metrics|node-exporter\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Generator load",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(otelcol_receiver_accepted_spans_total[5m]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Collector logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"pipeline\"}"
        }
      ]
    },
    {
      "id": 10,
      "type": "traces",
      "title": "Traces through the pipeline",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "query": "{ resource.service.name = \"synthetic-load\" }"
        }
      ]
    }
  ]
}
